# KnowledgeRadar runtime configuration example.
# Copy this file to the repository root as ".env" and fill your own values.
# Runtime key loading is intentionally restricted to the root .env file.
#
# Requiredness model:
# - Server startup: none of these provider keys is mandatory.
# - Real web search: configure at least one of TAVILY_API_KEY, ANYSEARCH_API_KEY,
#   BRAVE_SEARCH_API_KEY or EXA_API_KEY.
# - Platform/API features degrade explicitly when their own key is blank.

KR_MCP_HOST=127.0.0.1
KR_MCP_PORT=18765
KR_MCP_TRANSPORT=streamable-http
KR_MCP_PATH=/mcp
KR_WEB_SEARCH_PROVIDERS=anysearch,tavily

# General web search providers.
# Missing all search providers disables kr_web_search's live web coverage.
# Tavily: https://app.tavily.com/
TAVILY_API_KEY=
# AnySearch: your AnySearch service/API provider.
ANYSEARCH_API_KEY=
# Brave Search API: https://api.search.brave.com/
BRAVE_SEARCH_API_KEY=
# Exa: https://dashboard.exa.ai/
EXA_API_KEY=

# Platform and content APIs.
# YouTube Data API v3: Google Cloud Console. Without it, YouTube search degrades.
YOUTUBE_API_KEY=
# OpenAlex: https://openalex.org/. Optional higher quota contact/API configuration.
OPENALEX_API_KEY=
# Semantic Scholar: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
# Baidu Qianfan/Baidu Scholar official API bearer token. Without it, that
# academic provider reports EXPECTED_DEGRADED; open full-text providers still run.
BAIDU_QIANFAN_BEARER_TOKEN=
# SerpAPI Google Scholar: https://serpapi.com/
SERPAPI_API_KEY=
# CORE API: https://core.ac.uk/services/api. Without it, CORE is skipped.
KR_CORE_API_KEY=
# Unpaywall email: https://unpaywall.org/products/api
KR_UNPAYWALL_EMAIL=

# Model and multimodal providers.
# Without these, OCR/video/comment filtering/model-backed fallbacks degrade to
# local or non-model paths where available.
# DashScope/Bailian: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=
DASHSCOPE_MULTIMODAL_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
DASHSCOPE_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Generic LLM helpers. Configure only if a helper explicitly uses it.
# Defaults to the DeepSeek OpenAI-compatible endpoint for keyword expansion.
# Mimo provider integration.
# TikHub paid fallback for Xiaohongshu. Without it, paid final fallback is unavailable.
TIKHUB_API_KEY=

# Academic quota controls.
KR_ACADEMIC_BAIDU_DAILY_LIMIT=50
KR_ACADEMIC_ENABLE_SERPAPI=true
KR_ACADEMIC_SERPAPI_DAILY_LIMIT=8
KR_SERPAPI_MONTHLY_LIMIT=250
KR_ACADEMIC_IMPORT_MAX_BYTES=1048576

# Media/model routing. Leave empty unless you intentionally change routing.
KR_BASIC_TEXT_MODELS=
KR_ASR_MODELS=local:qwen3-asr/0.6b-onnx-int8
KR_OCR_MODELS=siliconflow:PaddlePaddle/PaddleOCR-VL-1.5
KR_FRAME_VISION_MODELS=bailian:qwen3.8-omni-flash
KR_NATIVE_VIDEO_MODELS=bailian:qwen3.8-omni-flash
KR_NATIVE_AUDIO_VIDEO_MODELS=bailian:qwen3.8-omni-flash

# Browser/runtime overrides.
# Prefer an installed Chrome for account/Profile based platforms. Playwright
# Chromium is only a fallback for generic dynamic extraction or sandbox tests.
KR_CHROME_EXE=
KR_NODE_EXE=
KR_PROFILE_REGISTRY_PATH=config/profile_registry.json
KR_XHS_CHROME_DEBUG_PORT=12733
KR_XHS_CHROME_USER_DATA_DIR=
KR_FFMPEG_EXE=
KR_FFMPEG_BIN=
KR_BROWSER_DATA_DIR=
PLAYWRIGHT_BROWSERS_PATH=

# TikHub fallback: optional key, at most 2 actual API requests/day.
# Independent quotas are defined in config/paid-policy.example.json.
# Retired: KR_XHS_TIKHUB_BREAK_GLASS_DRY_RUN / KR_XHS_ALLOW_LEGACY_PROFILE_FALLBACK.
# These keys no longer change admission; consult get_capabilities(tool_name='search_xiaohongshu').
# Discovery window (not a source-exhaustion claim); force_probe keeps its own small window.
KR_XHS_DEFAULT_SEARCH_LIMIT=20

# Optional proxy.
# HTTPX/yt-dlp based providers read HTTP_PROXY / HTTPS_PROXY / ALL_PROXY.
# On Windows, KnowledgeRadar can also fall back to the current user's system proxy.
# Set KR_DISABLE_WINDOWS_PROXY_FALLBACK=1 if you want to force env-only proxy discovery.
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=127.0.0.1,localhost
KR_DISABLE_WINDOWS_PROXY_FALLBACK=0

# Optional V2EX personal token: official v2 node/detail/replies; blank uses public HTML.
KR_V2EX_TOKEN=

# GitHub public research: REST/optional gh share one read-only contract.
KR_GITHUB_ENABLED=1
KR_GITHUB_TRANSPORT=auto
KR_GH_CLI_ENABLED=1
KR_GITHUB_MAX_FILE_BYTES=2097152
# Increment only after an intentional credential-context change.
KR_GITHUB_AUTH_EPOCH=
