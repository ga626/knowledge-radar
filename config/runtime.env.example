TAVILY_API_KEY=
KR_WEB_SEARCH_PROVIDERS=anysearch,tavily
YOUTUBE_API_KEY=
ANYSEARCH_API_KEY=
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=

# Optional academic enhancement.
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
# 万方当前官方接口：X-App-Key；需单独申请应用检索权限。
WFDATA_APP_KEY=
WFDATA_ENABLED=false
WFDATA_BASE_URL=https://api.wfdata.com
# Keep SerpAPI scarce unless you intentionally spend monthly search credits.
SERPAPI_API_KEY=
KR_ACADEMIC_ENABLE_SERPAPI=true
KR_ACADEMIC_SERPAPI_DAILY_LIMIT=8
KR_SERPAPI_MONTHLY_LIMIT=250
KR_ACADEMIC_IMPORT_MAX_BYTES=1048576

SILICONFLOW_API_KEY=
DASHSCOPE_API_KEY=
# Paid sends require an explicit local policy with verified request ceilings.
KR_PAID_POLICY_PATH=
DASHSCOPE_MULTIMODAL_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
DASHSCOPE_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TIKHUB_API_KEY=

# MCP server runtime.
KR_MCP_HOST=127.0.0.1
KR_MCP_PORT=18765
KR_MCP_TRANSPORT=streamable-http
# Legacy local-helper flag only. It does not add MCP tools.
KR_EXPOSE_PLANNING_TOOLS=false

KR_ASR_MODELS=local:qwen3-asr/0.6b-onnx-int8
KR_SUBTITLE_PROBE_CONCURRENCY=6
KR_MEDIA_DOWNLOAD_CONCURRENCY=2
KR_ASR_CPU_CONCURRENCY=1
KR_ASR_GPU_CONCURRENCY=1
KR_PROVIDER_CONCURRENCY_BAILIAN=1
KR_FRAME_VISION_CONCURRENCY=2
KR_OCR_MODELS=siliconflow:PaddlePaddle/PaddleOCR-VL-1.5
KR_FRAME_VISION_MODELS=bailian:qwen3.8-omni-flash
KR_NATIVE_VIDEO_MODELS=bailian:qwen3.8-omni-flash
KR_NATIVE_AUDIO_VIDEO_MODELS=bailian:qwen3.8-omni-flash

# Runtime media cache. Defaults to runtime/media_cache under KR_STATE_DIR.
KR_STATE_DIR=
KR_LOG_DIR=
KR_MEDIA_CACHE_DIR=
KR_RUNTIME_MEDIA_DIR=
KR_TRANSCRIBE_OUTPUT_DIR=
KR_TASK_DB_PATH=
KR_TASK_WORKER_MODE=local_thread_sqlite
KR_NATIVE_AUTO_MAX_DURATION_SECONDS=300
KR_NATIVE_AUTO_MAX_FRAMES=16
KR_NATIVE_AUTO_FPS=1
KR_NATIVE_AUTO_MAX_INPUT_TOKENS=12000
KR_NATIVE_AUTO_TIMEOUT_SECONDS=90

HTTPS_PROXY=
HTTP_PROXY=
KR_PROXY_RULE_DIRECT_URLS=https://raw.githubusercontent.com/Loyalsoldier/clash-rules/release/direct.txt
KR_PROXY_RULE_PROXY_URLS=https://raw.githubusercontent.com/Loyalsoldier/clash-rules/release/proxy.txt
KR_PROXY_RULE_CACHE_DIR=
KR_PROXY_RULE_TTL_SECONDS=604800

# Optional browser/runtime executable overrides. KR_CHROME_EXE must point to
# Google Chrome. Managed login/CDP sessions never silently fall back to Edge.
KR_CHROME_EXE=
KR_NODE_EXE=
KR_FFMPEG_EXE=
KR_FFMPEG_BIN=
KR_BROWSER_DATA_DIR=
PLAYWRIGHT_BROWSERS_PATH=
KR_PROFILE_REGISTRY_PATH=

# Optional CNKI authorized-browser profile. Disabled until the user explicitly
# logs in/authorizes in this managed Chrome profile.
KR_CNKI_CHROME_DEBUG_PORT=12740
KR_CNKI_CHROME_USER_DATA_DIR=
KR_CNKI_CHROME_PROFILE_DIRECTORY=
KR_CNKI_STARTUP_URL=https://kns.cnki.net/kns8s/search
# Xiaohongshu uses the pinned OpenCLI runtime and the user's daily Chrome only.
# The extension and browser context require explicit user confirmation.
KR_XHS_OPENCLI_ROOT=
KR_XHS_OPENCLI_ADAPTER_SHA256=
KR_XHS_OPENCLI_CONTEXT_ID=
KR_XHS_OPENCLI_STATE_DIR=
# Optional override; defaults to enabled with one CNY 50/day estimated budget.
KR_PAID_POLICY_PATH=

# GitHub public research: REST/optional gh share one read-only contract.
KR_GITHUB_ENABLED=1
KR_GITHUB_TRANSPORT=auto
KR_GH_CLI_ENABLED=1
KR_GITHUB_MAX_FILE_BYTES=2097152
# Increment only after an intentional credential-context change.
KR_GITHUB_AUTH_EPOCH=
