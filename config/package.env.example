# KnowledgeRadar product-lite local override example.
# Copy values into the repository-root .env file.

KR_MCP_PORT=18765
KR_MCP_TRANSPORT=streamable-http
# Legacy local-helper flag only. It does not add MCP tools.
KR_EXPOSE_PLANNING_TOOLS=false

# Optional provider/API configuration.
KR_WEB_SEARCH_PROVIDERS=tavily,brave,exa,anysearch,searxng
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
YOUTUBE_API_KEY=

# Optional academic enhancement.
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
BAIDU_QIANFAN_BEARER_TOKEN=
KR_ACADEMIC_BAIDU_DAILY_LIMIT=50
# Free SerpAPI plans are low quota, so this should be used explicitly for
# Chinese academic enrichment.
SERPAPI_API_KEY=
KR_ACADEMIC_ENABLE_SERPAPI=true
KR_ACADEMIC_SERPAPI_DAILY_LIMIT=8
KR_SERPAPI_MONTHLY_LIMIT=250
KR_ACADEMIC_IMPORT_MAX_BYTES=1048576

SILICONFLOW_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_MULTIMODAL_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
DASHSCOPE_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MIMO_API_URL=https://api.xiaomimimo.com/v1
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.5

# Media model policy defaults. Leave KR_BASIC_TEXT_MODELS empty unless a caller
# explicitly wants text compression/summarization.
KR_BASIC_TEXT_MODELS=
KR_ASR_MODELS=local:faster-whisper/base,local:faster-whisper/tiny
KR_ASR_BATCH_SIZE=8
KR_WHISPER_MODEL_DIR=
KR_ASR_LIFECYCLE=task_burst
KR_ASR_PREWARM_TRIGGER=subtitle_miss
KR_ASR_GPU_HOT_TTL_SECONDS=120
KR_ASR_WORKER_KEEPALIVE_SECONDS=300
KR_ASR_GPU_UNLOAD_POLICY=to_cpu_then_terminate
KR_ASR_ENABLE_CTRANSLATE2_UNLOAD=true
KR_ASR_GPU_MIN_FREE_MB=2048
KR_SUBTITLE_PROBE_CONCURRENCY=6
KR_MEDIA_DOWNLOAD_CONCURRENCY=2
KR_ASR_CPU_CONCURRENCY=1
KR_ASR_GPU_CONCURRENCY=1
KR_PROVIDER_CONCURRENCY_BAILIAN=3
KR_FRAME_VISION_CONCURRENCY=2
KR_OCR_MODELS=PaddlePaddle/PaddleOCR-VL-1.5
KR_FRAME_VISION_MODELS=bailian:qwen3-vl-flash
KR_NATIVE_VIDEO_MODELS=bailian:qwen3-vl-flash
KR_NATIVE_AUDIO_VIDEO_MODELS=bailian:qwen3.5-omni-flash
KR_COMMENT_FILTER_MODELS=bailian:qwen3.5-flash
KR_ENABLE_SILICONFLOW_FALLBACK=false
KR_ENABLE_MIMO_FALLBACK=false

# Runtime media cache. Defaults to runtime/media_cache under KR_STATE_DIR.
KR_STATE_DIR=
KR_LOG_DIR=
KR_MEDIA_CACHE_DIR=
KR_RUNTIME_MEDIA_DIR=
KR_TRANSCRIBE_OUTPUT_DIR=
KR_TASK_DB_PATH=
KR_TASK_WORKER_MODE=local_thread_sqlite
KR_NATIVE_AUTO_MAX_DURATION_SECONDS=300
KR_NATIVE_AUTO_MAX_FRAMES=16
KR_NATIVE_AUTO_FPS=1
KR_NATIVE_AUTO_MAX_INPUT_TOKENS=12000
KR_NATIVE_AUTO_TIMEOUT_SECONDS=90

# Optional proxy.
HTTP_PROXY=
HTTPS_PROXY=
KR_PROXY_RULE_DIRECT_URLS=https://raw.githubusercontent.com/Loyalsoldier/clash-rules/release/direct.txt
KR_PROXY_RULE_PROXY_URLS=https://raw.githubusercontent.com/Loyalsoldier/clash-rules/release/proxy.txt
KR_PROXY_RULE_CACHE_DIR=
KR_PROXY_RULE_TTL_SECONDS=604800

# Optional browser/runtime paths. KR_CHROME_EXE must point to Google Chrome.
# Managed login/CDP sessions never silently fall back to Edge.
KR_CHROME_EXE=
KR_NODE_EXE=
KR_FFMPEG_EXE=
KR_FFMPEG_BIN=
KR_CAMOUFOX_EXE=
KR_BROWSER_DATA_DIR=
PLAYWRIGHT_BROWSERS_PATH=
KR_PROFILE_REGISTRY_PATH=

# Optional CNKI authorized-browser profile. Disabled until the user explicitly
# logs in/authorizes in this managed Chrome profile.
KR_CNKI_CHROME_DEBUG_PORT=12740
KR_CNKI_CHROME_USER_DATA_DIR=
KR_CNKI_CHROME_PROFILE_DIRECTORY=
KR_CNKI_STARTUP_URL=https://kns.cnki.net/kns8s/search
