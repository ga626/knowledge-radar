{
  "schema": "knowledgeradar-public-source-manifest/v1",
  "description": "Tracked, reviewable files allowed to form the future public GitHub repository.",
  "include": [
    "README.md",
    "README.en.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    ".gitignore",
    ".env.example",
    "pyproject.toml",
    "start.cmd",
    "start-knowledgeradar-server.cmd",
    "start-knowledgeradar-server-detached.py",
    "start-knowledgeradar-server-hidden.ps1",
    "src/**",
    "tests/**",
    "scripts/build_product_lite_package.py",
    "scripts/build_public_source_projection.py",
    "scripts/verify_package_integrity.py",
    "scripts/generate-mcp-config.py",
    "scripts/setup_codex_product.py",
    "scripts/setup_accounts.bat",
    "scripts/open_academic_login_profiles.py",
    "scripts/install.bat",
    "scripts/setup_agent.bat",
    "scripts/verify_api_keys.py",
    "scripts/setup_wizard.bat",
    "scripts/start_setup_wizard.py",
    "scripts/verify_all_capabilities.py",
    "config/*.example",
    "config/codex-product/**",
    "config/mcp-config-template.json",
    "config/package-manifest.product-lite.json",
    "config/project-structure.manifest.json",
    "config/public-source-manifest.json",
    "config/selectors.json",
    "docs/ACCOUNT_SETUP.md",
    "docs/API_KEYS.md",
    "docs/SETUP_WIZARD.md",
    "docs/FAQ.md",
    "docs/INSTALL.md",
    "docs/MCP_SETUP.md",
    "docs/PRIVACY_AND_LOCAL_STATE.md",
    "docs/SEARXNG.md",
    "docs/AI_WORKING_GUIDE.md",
    "docs/文档索引.md",
    "docs/reference/PLATFORM_TEMPLATE.md",
    ".github/**",
    "bridge/package.json",
    "bridge/package-lock.json",
    "bridge/.npmrc",
    "bridge/*.cjs",
    "bridge/*.mjs",
    "bridge/README.md"
  ],
  "exclude": [
    ".codex/**",
    ".githooks/**",
    "AGENTS.md",
    "archive/**",
    "project_status/**",
    "tools/**",
    "local/**",
    "browser_data/**",
    "runtime/**",
    "data/**",
    "dist/**",
    "release/**"
  ]
}
