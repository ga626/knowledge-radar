    "pyproject.toml", "src/**", "bridge/package.json", "bridge/package-lock.json", "bridge/*.cjs", "bridge/*.mjs", "bridge/README.md",
    "scripts/build_product_lite_package.py", "scripts/verify_package_integrity.py", "scripts/verify_release_candidate.py", "scripts/product_install.py", "scripts/generate-mcp-config.py", "scripts/setup_codex_product.py", "scripts/install.bat", "scripts/setup_agent.bat", "scripts/setup_wizard.bat", "scripts/start_setup_wizard.py", "scripts/setup_product_wizard.py", "scripts/verify_codex_product.py", "scripts/verify_api_keys.py", "scripts/verify_all_capabilities.py",
    "config/*.example", "config/profile_registry.example.json", "config/mcp*.json", "config/codex-product/**", "config/package-manifest.product-lite.json", "config/project-structure.manifest.json", "config/selectors.json",
    "docs/ACCOUNT_SETUP.md", "docs/API_KEYS.md", "docs/CAPABILITY_PACKS.md", "docs/FAQ.md", "docs/FIRST_SUCCESS.md", "docs/DEVELOPER.md", "docs/INSTALL.md", "docs/MCP_SETUP.md", "docs/PRIVACY_AND_LOCAL_STATE.md", "docs/PRODUCT_INSTALL.md", "docs/RELEASE_CANDIDATE.md", "docs/SEARXNG.md", "docs/SETUP_WIZARD.md", "CHANGELOG.md", "SUPPORT.md", "CODE_OF_CONDUCT.md"
  ],
  "exclude": [".git/**", ".codex/**", ".githooks/**", "AGENTS.md", ".env", ".python312/**", "dist/**", "release/**", "backups/**", "browser_data/**", "data/**", "src/data/**", "src/*.egg-info/**", "config/profile_registry.json", "local/**", "project_status/**", "tools/**", "archive/**", "runtime/logs/**", "runtime/reports/**", "runtime/tasks/**", "runtime/cache/**", "runtime/media_cache/**", "runtime/*.json", "runtime/*.jsonl", "runtime/*.sqlite*", "runtime/*.db", "bridge/node_modules/**", "**/__pycache__/**", "**/*.pyc", "**/*.log", "**/*.sqlite*", "**/node_modules/**"],
  "user_must_configure": ["API keys and provider credentials", "proxy settings", "browser profile registry", "optional Python runtime"]
}
