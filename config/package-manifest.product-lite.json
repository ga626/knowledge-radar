    "docs/reference/browser-lifecycle-full-report.md",
    "docs/**/*Report*.md",
    "docs/**/*Plan*.md",
    "docs/**/*Research*.md",
    "docs/**/*Investigation*.md",
    "docs/**/*Review*.md",
    "docs/**/*Audit*.md",
    "docs/**/*Assessment*.md",
    "docs/**/*Execution*.md",
    "docs/**/*-20*.md",
    "docs/**/*202*.md",
    "docs/reference/*Report*.md",
    "docs/reference/*Plan*.md",
    "docs/reference/*Research*.md",
    "docs/reference/*Investigation*.md",
    "docs/reference/*Review*.md",
